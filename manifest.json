{
  "manifest_version": 3,
  "name": "Xbox Cloud Gaming Fix for Brave",
  "version": "1.0",
  "description": "Fixes play.xbox.com blank white screen in Brave by removing sec-ch-ua client hints.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://play.xbox.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
